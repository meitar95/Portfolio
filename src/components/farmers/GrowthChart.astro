---
// Task events logged in the app per year (millions). Source: Afimilk HQ analytics.
const years = [
  { y: '2022', v: 0.03 },
  { y: '2023', v: 0.15 },
  { y: '2024', v: 0.29 },
];
const max = 0.3;
---
<figure class="gc">
  <div class="gc__chart" role="img" aria-label="Task events logged in the app: 0.03 million in 2022, 0.15 million in 2023, 0.29 million in 2024">
    {years.map((d) => (
      <div class="gc__col">
        <div class="gc__track">
          <span class="gc__v">{d.v}M</span>
          <span class="gc__bar" style={`height: ${Math.round((d.v / max) * 170)}px`}></span>
        </div>
        <span class="gc__y">{d.y}</span>
      </div>
    ))}
  </div>
  <figcaption><b>Task events logged in the app, per year.</b> Each one is a task a farmer did in the app instead of on paper. From a check we ran with Afimilk's analysts.</figcaption>
</figure>

<style>
  .gc { display: grid; gap: var(--s-2); margin: 0; }
  .gc figcaption { font-size: var(--fs-small); color: var(--ink-3); }
  .gc figcaption b { color: var(--ink); font-weight: 500; }
  .gc__chart {
    display: grid; grid-template-columns: repeat(3, minmax(0, 120px)); justify-content: center; gap: clamp(1rem, 6vw, 4rem);
    padding: var(--s-3) var(--s-3) var(--s-2); border-radius: var(--radius-md); background: var(--bg);
  }
  .gc__col { display: grid; gap: 6px; justify-items: center; align-content: end; }
  .gc__track { width: 100%; height: 200px; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 6px; }
  .gc__bar { width: 100%; min-height: 4px; border-radius: 8px 8px 2px 2px; background: var(--tint-4); }
  .gc__col:last-child .gc__bar { background: var(--accent); }
  .gc__v { font-weight: 500; color: var(--ink); }
  .gc__y { font-size: var(--fs-small); color: var(--ink-3); }
</style>
