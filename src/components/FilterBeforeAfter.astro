---
// Interactive before/after for the Filtering case study.
// Rebuilt in HTML from the Figma prototype so text stays sharp at any size,
// and the viewer explores at their own pace (replaces the MP4s).
// All data is generic (confidentiality).
const chevron = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const right = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const sparkle = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 1.5l1.6 4.9 4.9 1.6-4.9 1.6L8 14.5l-1.6-4.9L1.5 8l4.9-1.6z" fill="currentColor"/></svg>';
const search = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
const funnel = '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 3h12l-4.5 5.5V13l-3-1.5v-3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>';
const plus = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
const reset = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.3-3.2M3.5 2.5v2.5H6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const quick = [
  { id: 'critical', label: 'Critical only', f: 0.15 },
  { id: 'week', label: 'Opened this week', f: 0.3 },
  { id: 'mine', label: 'Assigned to me', f: 0.25 },
  { id: 'aws', label: 'AWS findings', f: 0.4 },
  { id: 'impact', label: 'Impact > $10K', f: 0.2 },
];
---
<figure class="ba" data-ba>
  <div class="ba__switch" role="group" aria-label="Compare filtering before and after">
    <button type="button" data-show="before" aria-pressed="false">Before <span>4 patterns</span></button>
    <button type="button" data-show="after" aria-pressed="true">After <span>1 system</span></button>
  </div>

  <div class="ba__stage">
    <!-- ================= BEFORE ================= -->
    <div class="ba__panel" data-panel="before" hidden>
      <p class="ba__intro">The same task — "show me what needs fixing" — looked different in every module.</p>

      <div class="old">
        <p class="old__name"><b>Findings</b> · funnel + toggles</p>
        <div class="row">
          <span class="ui-input"><span>Search</span><Fragment set:html={search} /></span>
          <span class="ui-icon"><Fragment set:html={funnel} /></span>
          <span class="ui-chip ui-chip--on">Active only (2)</span>
          <span class="ui-link mark">Show filters <Fragment set:html={chevron} /></span>
          <span class="ui-link">Clear all</span>
          <span class="ui-meta">104 matching · 257 total</span>
          <span class="ui-select">Group by: Recipe → severity <Fragment set:html={chevron} /></span>
        </div>
      </div>

      <div class="old">
        <p class="old__name"><b>Log analysis</b> · dropdown grid</p>
        <div class="row">
          {['WAF', 'Domain', 'Action', 'Source IP', 'Time: Last 7 days', 'URI pattern', 'HTTP method', 'Country'].map((l) => (
            <span class="ui-select">{l} <Fragment set:html={chevron} /></span>
          ))}
          <span class="ui-link mark">See less filters</span>
        </div>
      </div>

      <div class="old">
        <p class="old__name"><b>Posture</b> · category pills</p>
        <div class="row">
          <span class="ui-input"><span>Search achievements</span><Fragment set:html={search} /></span>
          {['All', 'Benchmark', 'Posture', 'Milestone', 'Efficiency'].map((l, i) => (
            <span class:list={['ui-chip', { 'ui-chip--on': i === 0 }]}>{l}</span>
          ))}
        </div>
      </div>

      <div class="old">
        <p class="old__name"><b>Cloud inventory</b> · account selector + views</p>
        <div class="row">
          <span class="ui-select">AWS <Fragment set:html={chevron} /></span>
          {['ACL', 'Rules', 'ALB', 'Target groups'].map((l, i) => (
            <span class:list={['ui-tab', { 'ui-tab--on': i === 0 }]}>{l}</span>
          ))}
        </div>
        <div class="row">
          <span class="ui-select">7 days <Fragment set:html={chevron} /></span>
          <span class="ui-input"><span>search</span><Fragment set:html={search} /></span>
          <span class="ui-icon"><Fragment set:html={funnel} /></span>
          <span class="ui-chip mark">Cool view (1)</span>
        </div>
      </div>

      <p class="ba__note"><span class="mark">Highlighted</span>: three different words for showing, hiding and saving filters.</p>
    </div>

    <!-- ================= AFTER ================= -->
    <div class="ba__panel" data-panel="after">
      <div class="row row--between">
        <div class="row" data-views>
          <span class="pin" aria-hidden="true">1</span>
          <button type="button" class="ui-ai" data-focus-ai><Fragment set:html={sparkle} /> Ask AI or search…</button>
          <button type="button" class="ui-view">My special view</button>
          <button type="button" class="ui-view">Critical AWS findings</button>
        </div>
        <div class="row save">
          <button type="button" class="ui-link" data-reset><Fragment set:html={reset} /> Reset</button>
          <span class="pin" aria-hidden="true">3</span>
          <button type="button" class="ui-save" data-save-toggle aria-expanded="false">Save view <Fragment set:html={chevron} /></button>
          <div class="pop" data-save-pop hidden>
            <label class="visually-hidden" for="ba-view-name">View name</label>
            <input id="ba-view-name" class="pop__input" value="Lower-severity cleanup" />
            <div class="row row--end">
              <button type="button" class="ui-link" data-save-cancel>Discard</button>
              <button type="button" class="ui-btn" data-save>Save</button>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <span class="ui-link ui-link--strong"><Fragment set:html={plus} /> Add filter</span>
        <div class="row" data-active></div>
        <button type="button" class="ui-link" data-clear>Clear all</button>
        <span class="ui-meta" aria-live="polite"><b data-count>257</b> of 257</span>
      </div>

      <div class="fp">
        <p class="fp__title">Filter panel</p>
        <label class="fp__ai">
          <Fragment set:html={sparkle} />
          <span class="visually-hidden">Describe what you want to see</span>
          <input data-ai placeholder="Describe what you want to see" />
        </label>
        <div class="fp__quick">
          <span class="ui-meta">Quick start:</span>
          {quick.map((q) => (
            <button type="button" class="ui-qs" data-q={q.id} data-f={q.f} aria-pressed="false">{q.label}</button>
          ))}
        </div>

        <div class="fp__tabs" role="tablist" aria-label="Filter mode">
          <span class="pin" aria-hidden="true">2</span>
          <button type="button" role="tab" id="tab-simple" aria-selected="true" aria-controls="tp-simple" data-tab="simple">Simple</button>
          <button type="button" role="tab" id="tab-adv" aria-selected="false" aria-controls="tp-adv" data-tab="adv" tabindex="-1">Advanced</button>
        </div>
        <div role="tabpanel" id="tp-simple" aria-labelledby="tab-simple">
          <p class="fp__group">Triage <Fragment set:html={chevron} /></p>
          <ul class="fp__list">
            <li><span><input type="checkbox" aria-label="Crown jewel" /> Crown jewel</span></li>
            {['Status', 'Severity', 'Category', 'Cloud provider'].map((l) => <li><span>{l}</span><Fragment set:html={right} /></li>)}
          </ul>
          <p class="fp__group fp__group--closed">Vendor & account <Fragment set:html={chevron} /></p>
          <p class="fp__group fp__group--closed">Location & asset <Fragment set:html={chevron} /></p>
        </div>
        <div role="tabpanel" id="tp-adv" aria-labelledby="tab-adv" hidden>
          <div class="rule"><span class="ui-select">Severity</span><span class="ui-select">is</span><span class="ui-select">Critical</span></div>
          <div class="rule"><span class="ui-meta">and</span><span class="ui-select">Asset</span><span class="ui-select">contains</span><span class="ui-select">payments-api</span></div>
          <span class="ui-link ui-link--accent"><Fragment set:html={plus} /> Add filter</span>
        </div>
      </div>
    </div>
  </div>

  <ol class="ba__legend" data-legend>
    <li><span class="pin">1</span><div><b>Ask AI</b> — type what you want in plain words.</div></li>
    <li><span class="pin">2</span><div><b>Simple / Advanced</b> — essentials first, depth on demand.</div></li>
    <li><span class="pin">3</span><div><b>Save view</b> — keep a filter set for next time.</div></li>
  </ol>
  <figcaption class="ba__caption">Interactive — try the quick-start chips, the tabs and Save view. Generic data for confidentiality.</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s as any)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s as any)];

    // Before / After switch
    const switches = $$<HTMLButtonElement>('[data-show]');
    const show = (which: string) => {
      switches.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.show === which)));
      $$('[data-panel]').forEach((p) => ((p as HTMLElement).hidden = p.getAttribute('data-panel') !== which));
      $('[data-legend]').toggleAttribute('hidden', which !== 'after');
    };
    switches.forEach((b) => b.addEventListener('click', () => show(b.dataset.show!)));

    // Quick-start chips → active filter chips + live count
    const total = 257;
    const active = $('[data-active]');
    const count = $('[data-count]');
    const chips = $$<HTMLButtonElement>('[data-q]');
    const render = () => {
      const on = chips.filter((c) => c.getAttribute('aria-pressed') === 'true');
      count.textContent = String(Math.max(1, Math.round(on.reduce((n, c) => n * Number(c.dataset.f), total))));
      active.replaceChildren(...on.map((c) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'ui-chip ui-chip--on';
        b.textContent = c.textContent + ' ×';
        b.setAttribute('aria-label', `Remove ${c.textContent}`);
        b.onclick = () => { c.setAttribute('aria-pressed', 'false'); render(); };
        return b;
      }));
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true')); render();
    }));
    const clearAll = () => { chips.forEach((c) => c.setAttribute('aria-pressed', 'false')); render(); };
    $('[data-clear]').addEventListener('click', clearAll);
    $('[data-reset]').addEventListener('click', clearAll);
    $('[data-focus-ai]').addEventListener('click', () => $<HTMLInputElement>('[data-ai]').focus());

    // Simple / Advanced tabs (arrow keys supported)
    const tabs = $$<HTMLButtonElement>('[data-tab]');
    const select = (t: HTMLButtonElement) => tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
      if (on) x.focus();
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') select(tabs[(i + 1) % tabs.length]);
      });
    });

    // Save view popover → adds a new saved view
    const toggle = $<HTMLButtonElement>('[data-save-toggle]');
    const pop = $('[data-save-pop]');
    const openPop = (open: boolean) => { pop.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); };
    toggle.addEventListener('click', () => openPop(pop.hidden));
    $('[data-save-cancel]').addEventListener('click', () => openPop(false));
    $('[data-save]').addEventListener('click', () => {
      const name = $<HTMLInputElement>('#ba-view-name').value.trim() || 'New view';
      const v = document.createElement('button');
      v.type = 'button'; v.className = 'ui-view ui-view--new'; v.textContent = name;
      $('[data-views]').append(v);
      openPop(false); toggle.focus();
    });
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) { openPop(false); toggle.focus(); } });
  });
</script>

<style>
  .ba { display: grid; gap: var(--s-3); }
  .ba__switch {
    justify-self: start; display: inline-flex; padding: 4px; gap: 4px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-pill);
  }
  .ba__switch button {
    border: 0; background: transparent; cursor: pointer;
    min-height: 40px; padding: 0 1.1rem; border-radius: var(--radius-pill);
    font-weight: 500; color: var(--ink);
  }
  .ba__switch button span { color: var(--ink-3); font-weight: 400; margin-left: 0.25rem; }
  .ba__switch button[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .ba__switch button[aria-pressed='true'] span { color: rgb(255 255 255 / 0.7); }
  @media (max-width: 480px) { .ba__switch button span { display: none; } }

  /* The "product" surface — product UI type sits at 14px, never smaller */
  .ba__stage {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md);
    padding: clamp(1rem, 3vw, 1.75rem);
    font-size: 0.875rem; line-height: 1.4; color: #2c3346;
    box-shadow: 0 1px 2px rgb(31 21 21 / 0.04), 0 12px 32px -12px rgb(31 21 21 / 0.12);
  }
  .ba__panel { display: grid; gap: 0.875rem; }
  .ba__intro { font-size: var(--fs-small); color: var(--ink-2); }
  .ba__note { font-size: 0.875rem; color: var(--ink-3); }
  .ba__caption { font-size: var(--fs-small); color: var(--ink-3); }

  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .row--between { justify-content: space-between; }
  .row--end { justify-content: flex-end; }

  .old { padding: 0.875rem 0; border-top: 1px solid #eceef2; display: grid; gap: 0.5rem; }
  .old:first-of-type { border-top: 0; }
  .old__name { color: #6b7180; }
  .old__name b { color: #2c3346; font-weight: 500; }
  .mark { background: var(--peach); border-radius: 4px; box-shadow: 0 0 0 3px var(--peach); }

  /* Mock UI atoms */
  .ui-input, .ui-select, .ui-chip, .ui-tab, .ui-icon, .ui-view, .ui-ai, .ui-save, .ui-btn, .ui-qs {
    display: inline-flex; align-items: center; gap: 0.375rem;
    min-height: 34px; padding: 0 0.75rem; border-radius: 8px;
    border: 1px solid #dde1e8; background: #fff; color: #2c3346; white-space: nowrap;
  }
  .ui-input { justify-content: space-between; min-width: 9rem; color: #9aa0ab; }
  .ui-icon { padding: 0 0.5rem; }
  .ui-chip--on { background: #e8eefb; border-color: #9fb4e6; color: #2848a8; }
  .ui-tab { border-color: transparent; }
  .ui-tab--on { background: #eef0f4; }
  .ui-link { display: inline-flex; align-items: center; gap: 0.25rem; color: #2f63d6; background: none; border: 0; padding: 0.4rem 0.25rem; cursor: pointer; }
  .ui-link--strong { color: #2c3346; font-weight: 500; }
  .ui-link--accent { margin-top: 0.25rem; }
  .ui-meta { color: #6b7180; }
  .ui-meta b { color: #2c3346; font-weight: 600; }

  button.ui-view, button.ui-ai, button.ui-save, button.ui-btn, button.ui-qs, button.ui-chip { cursor: pointer; font: inherit; }
  .ui-ai { border-color: #2f63d6; color: #2f63d6; border-radius: var(--radius-pill); }
  .ui-view { border-color: transparent; }
  .ui-view:hover { background: #f3f5f8; }
  .ui-view--new { background: #e8eefb; color: #2848a8; animation: pop-in 0.35s var(--ease); }
  .ui-save { background: #24315f; color: #fff; border-color: #24315f; }
  .ui-btn { background: #2f63d6; color: #fff; border-color: #2f63d6; }
  .ui-qs { background: #e3f1f5; border-color: transparent; min-height: 30px; padding: 0 0.6rem; }
  .ui-qs[aria-pressed='true'] { background: #2f63d6; color: #fff; }

  .save { position: relative; }
  .pop {
    position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 2;
    width: min(18rem, 80vw); padding: 0.75rem; display: grid; gap: 0.5rem;
    background: #fff; border: 1px solid #dde1e8; border-radius: 10px;
    box-shadow: 0 12px 32px -8px rgb(20 30 60 / 0.25);
  }
  .pop__input { font: inherit; padding: 0.5rem 0.6rem; border: 1px solid #c9cfda; border-radius: 6px; }

  .fp {
    width: min(100%, 26rem); padding: 1rem; display: grid; gap: 0.75rem;
    border: 1px solid #e3e6ec; border-radius: 12px;
    box-shadow: 0 8px 24px -10px rgb(20 30 60 / 0.18);
  }
  .fp__title { font-weight: 600; }
  .fp__ai {
    display: flex; align-items: center; gap: 0.5rem; padding: 0 0.75rem; min-height: 38px;
    border: 1px solid #7da0ea; background: #eef3fd; border-radius: 8px; color: #2f63d6;
  }
  .fp__ai input { flex: 1; min-width: 0; border: 0; background: transparent; font: inherit; color: #2c3346; outline: none; }
  .fp__ai:focus-within { box-shadow: 0 0 0 3px rgb(47 99 214 / 0.2); }
  .fp__quick { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .fp__tabs { display: flex; align-items: center; gap: 0.25rem; border-bottom: 1px solid #e3e6ec; }
  .fp__tabs button {
    border: 0; background: none; cursor: pointer; padding: 0.5rem 0.6rem; min-height: 40px;
    color: #4a5163; border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  .fp__tabs button[aria-selected='true'] { color: #2f63d6; border-color: #2f63d6; }
  .fp__group { display: flex; justify-content: space-between; color: #6b7180; padding-top: 0.25rem; }
  .fp__group :global(svg) { transform: rotate(180deg); }
  .fp__group--closed { border-top: 1px solid #eceef2; padding-top: 0.6rem; }
  .fp__group--closed :global(svg) { transform: none; }
  .fp__list { list-style: none; padding: 0; display: grid; }
  .fp__list li { display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.25rem; color: #2c3346; }
  .fp__list li span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .rule { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }

  .pin {
    display: inline-grid; place-items: center; flex: none;
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--accent); color: #fff; font-size: 0.8125rem; font-weight: 600; line-height: 1;
  }
  .ba__legend { list-style: none; padding: 0; display: grid; gap: var(--s-2); grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .ba__legend li { display: flex; gap: 0.75rem; align-items: baseline; font-size: var(--fs-small); }
  .ba__legend b { color: var(--ink); font-weight: 500; }

  @keyframes pop-in { from { transform: scale(0.9); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .ui-view--new { animation: none; } }
</style>
