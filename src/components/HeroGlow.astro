---
// The soft blue glow behind the hero. Pure CSS — no canvas, no JS.
// No box around it: the blobs are heavily blurred and free to drift past the
// hero's edges, so there's never a hard cut line. Colors are soft — the old
// near-black became a faint deep slate.
---
<div class="glow" aria-hidden="true">
  <span class="glow__blob glow__blob--a"></span>
  <span class="glow__blob glow__blob--b"></span>
  <span class="glow__blob glow__blob--c"></span>
</div>

<style>
  .glow {
    position: absolute; z-index: -1; pointer-events: none;
    top: -20vh; right: -10vw; width: 70vw; height: 110vh; /* bigger than the hero: no edges */
    filter: blur(90px);
  }
  .glow__blob { position: absolute; border-radius: 50%; will-change: transform; }
  .glow__blob--a { /* baby blue — the main wash */
    width: 55%; aspect-ratio: 1; left: 30%; top: 10%;
    background: #9bd9de; opacity: 0.55;
  }
  .glow__blob--b { /* steel blue — depth */
    width: 34%; aspect-ratio: 1; left: 45%; top: 25%;
    background: #3f6c88; opacity: 0.22;
  }
  .glow__blob--c { /* faint deep slate — what used to be black */
    width: 24%; aspect-ratio: 1; left: 58%; top: 18%;
    background: #2e3a52; opacity: 0.12;
  }
  @media (max-width: 809px) {
    .glow { right: -40vw; width: 120vw; height: 80vh; top: -25vh; filter: blur(60px); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .glow__blob--a { animation: wander-a 16s ease-in-out infinite alternate; }
    .glow__blob--b { animation: wander-b 13s ease-in-out infinite alternate; }
    .glow__blob--c { animation: wander-c 19s ease-in-out infinite alternate; }
  }
  /* Visible, slow wandering — like the Framer gradient, but calmer */
  @keyframes wander-a {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(-28%, 18%) scale(1.15); }
    100% { transform: translate(-45%, -6%) scale(0.95); }
  }
  @keyframes wander-b {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(-60%, -20%) scale(1.25); }
    100% { transform: translate(-20%, 35%) scale(0.9); }
  }
  @keyframes wander-c {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(-90%, 40%) scale(1.3); }
    100% { transform: translate(-40%, -30%) scale(1); }
  }
</style>
