---
/**
 * Drag-to-compare slider, shared by every case study.
 * Images live at `${dir}/${id}-before-800.webp`, `-1600.webp` (and the same for -after).
 * Tabs appear only when there is more than one pair.
 * Only the handle drags (a stray tap on the image does nothing). The Before / After tags are
 * buttons that glide the handle all the way to show that side. Arrow keys work via the range input.
 */
type Pair = { id: string; label: string; note: string };
interface Props { pairs: Pair[]; dir: string; w: number; h: number; caption: string; altAfter: string; dark?: boolean }
const { pairs, dir, w, h, caption, altAfter, dark = true } = Astro.props;
const img = (id: string, v: 'before' | 'after') => `${dir}/${id}-${v}`;
const uid = `bas-${Math.random().toString(36).slice(2, 8)}`;
const first = pairs[0].id;
---
<figure class="bas" data-bas data-dir={dir} style={`--ratio: ${w} / ${h}`}>
  <div class="bas__top">
    {pairs.length > 1 && <div class="bas__tabs" role="tablist" aria-label="Choose a screen">
      {pairs.map((p, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pair={p.id} data-note={p.note}>{p.label}</button>)}
    </div>}
    <p class="bas__note" data-note-out aria-live="polite">{pairs[0].note}</p>
  </div>

  <div class={`bas__stage${dark ? '' : ' bas__stage--light'}`} data-stage style="--pos: 50%">
    <img class="bas__img" data-after src={`${img(first, 'after')}-1600.webp`} srcset={`${img(first, 'after')}-800.webp 800w, ${img(first, 'after')}-1600.webp 1600w`} sizes="(max-width: 1080px) 100vw, 1080px" width={w} height={h} alt={altAfter} />
    <div class="bas__clip" aria-hidden="true">
      <img class="bas__img" data-before src={`${img(first, 'before')}-1600.webp`} srcset={`${img(first, 'before')}-800.webp 800w, ${img(first, 'before')}-1600.webp 1600w`} sizes="(max-width: 1080px) 100vw, 1080px" width={w} height={h} alt="" />
    </div>
    <button type="button" class="zoom-btn" data-bas-zoom aria-label="Enlarge before and after"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></button>
    <button type="button" class="bas__tag bas__tag--before" data-show="100" aria-label="Show before">Before</button>
    <button type="button" class="bas__tag bas__tag--after" data-show="0" aria-label="Show after">After</button>
    <div class="bas__handle" data-handle aria-hidden="true"><span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18-6-6 6-6M15 6l6 6-6 6"/></svg>
    </span></div>
    <label class="visually-hidden" for={uid}>Compare before and after</label>
    <input id={uid} class="bas__range" type="range" min="0" max="100" value="50" data-range />
  </div>
  <figcaption class="bas__caption">{caption}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-bas]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const range = root.querySelector<HTMLInputElement>('[data-range]')!;
    const before = root.querySelector<HTMLImageElement>('[data-before]')!;
    const after = root.querySelector<HTMLImageElement>('[data-after]')!;
    const note = root.querySelector<HTMLElement>('[data-note-out]')!;
    const dir = root.dataset.dir!;
    const tags = root.querySelectorAll<HTMLButtonElement>('[data-show]');
    const set = (v: number) => {
      stage.style.setProperty('--pos', `${v}%`);
      tags.forEach((t) => t.classList.toggle('is-on', Math.abs(+t.dataset.show! - v) < 3));
    };
    // Glide (used by the tags and tab changes); dragging stays instant
    const glide = (v: number) => {
      stage.classList.add('is-gliding'); range.value = String(v); set(v);
      setTimeout(() => stage.classList.remove('is-gliding'), 650);
    };
    range.addEventListener('input', () => set(+range.value));
    tags.forEach((t) => t.addEventListener('click', () => {
      const v = +t.dataset.show!;
      glide(Math.abs(+range.value - v) < 3 ? 50 : v); // tap again to go back to the middle
    }));
    root.querySelector('[data-bas-zoom]')!.addEventListener('click', () => dispatchEvent(new CustomEvent('zoom', { detail: { start: 1, items: [
      { src: before.getAttribute('src')!, label: 'Before' }, { src: after.getAttribute('src')!, label: 'After' }] } })));
    // Drag only from the handle
    const handle = root.querySelector<HTMLElement>('[data-handle]')!;
    const toPos = (x: number) => { const r = stage.getBoundingClientRect(); return Math.min(100, Math.max(0, Math.round(((x - r.left) / r.width) * 100))); };
    handle.addEventListener('pointerdown', (e) => { e.preventDefault(); handle.setPointerCapture(e.pointerId); stage.classList.add('is-dragging'); });
    handle.addEventListener('pointermove', (e) => { if (!handle.hasPointerCapture(e.pointerId)) return; const v = toPos(e.clientX); range.value = String(v); set(v); });
    const end = () => stage.classList.remove('is-dragging');
    handle.addEventListener('pointerup', end); handle.addEventListener('pointercancel', end);
    root.querySelectorAll<HTMLButtonElement>('[data-pair]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-pair]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      const id = b.dataset.pair!;
      for (const [el, v] of [[before, 'before'], [after, 'after']] as const) {
        el.src = `${dir}/${id}-${v}-1600.webp`;
        el.srcset = `${dir}/${id}-${v}-800.webp 800w, ${dir}/${id}-${v}-1600.webp 1600w`;
      }
      note.classList.add('is-out');
      setTimeout(() => { note.textContent = b.dataset.note!; note.classList.remove('is-out'); }, 220);
      glide(50);
    }));
  });
</script>

<style>
  .bas { display: grid; gap: var(--s-3); margin: 0; }
  .bas__top { display: grid; gap: var(--s-2); justify-items: start; }
  .bas__tabs { display: inline-flex; gap: 4px; padding: 4px; background: var(--tint-1); border-radius: var(--radius-pill); flex-wrap: wrap; }
  .bas__tabs button {
    border: 0; background: none; cursor: pointer; min-height: 40px; padding: 0 1.1rem; border-radius: var(--radius-pill);
    font-size: var(--fs-small); font-weight: 500; color: var(--ink-3); transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .bas__tabs button[aria-selected='true'] { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgb(31 21 21 / 0.08), 0 2px 8px -2px rgb(31 21 21 / 0.12); }
  .bas__note { color: var(--ink); transition: opacity 0.45s var(--ease), transform 0.45s var(--ease), filter 0.45s var(--ease); }
  .bas__note.is-out { opacity: 0; transform: translateY(4px); filter: blur(3px); transition-duration: 0.2s; }

  .bas__stage {
    position: relative; overflow: hidden; border-radius: var(--radius-md); background: #10162a;
    aspect-ratio: var(--ratio); touch-action: pan-y; user-select: none;
    box-shadow: 0 16px 40px -16px rgb(16 22 42 / 0.45);
  }
  .bas__stage--light { background: #f4f6f8; }
  .bas__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .bas__clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .bas__handle {
    position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.15); cursor: ew-resize; touch-action: none; z-index: 3;
  }
  .bas__handle::before { content: ''; position: absolute; inset: 0 -14px; } /* wider grab area along the line */
  .bas__stage.is-gliding .bas__clip { transition: clip-path 0.6s var(--ease); }
  .bas__stage.is-gliding .bas__handle { transition: left 0.6s var(--ease); }
  .bas__stage.is-dragging { cursor: ew-resize; }
  .bas__handle span {
    position: absolute; transition: transform 0.2s var(--ease); top: 50%; left: 50%; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: #fff; color: var(--ink); box-shadow: 0 4px 16px rgb(0 0 0 / 0.3);
  }
  .bas__handle:hover span, .is-dragging .bas__handle span { transform: translate(-50%, -50%) scale(1.06); }
  /* Keyboard only: the range stays focusable for arrow keys, but never catches clicks */
  .bas__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; pointer-events: none; }
  .bas__range:focus-visible ~ .bas__handle span, .bas__stage:has(.bas__range:focus-visible) .bas__handle span { outline: 3px solid var(--tint-5); outline-offset: 2px; }
  .bas__tag {
    position: absolute; bottom: 12px; padding: 0.25rem 0.625rem; border-radius: 6px;
    border: 0; background: rgb(0 0 0 / 0.55); color: #fff; font: 500 0.875rem/1.4 var(--sans); cursor: pointer; z-index: 4;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); transition: background 0.25s, color 0.25s;
  }
  .bas__tag::after { content: ''; position: absolute; inset: -8px; } /* 44px touch target */
  .bas__tag:hover { background: rgb(0 0 0 / 0.75); }
  .bas__tag.is-on { background: #fff; color: var(--ink); }
  .bas__tag:focus-visible { outline: 3px solid var(--tint-5); outline-offset: 2px; }
  .bas__tag--before { left: 12px; }
  .bas__tag--after { right: 12px; }
  .bas__caption { font-size: var(--fs-small); color: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) { .bas__note, .bas__clip, .bas__handle { transition: none !important; } }
</style>
