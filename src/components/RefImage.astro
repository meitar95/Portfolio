---
// A real reference image (Figma frame, screenshot) with a caption.
// `src` is the base path: /images/<name> → <name>-800.webp + <name>-1600.webp
// `bare`: for cut-out mockups with a transparent background (no frame, soft floating shadow).
interface Props { src: string; alt: string; caption?: string; bare?: boolean; w?: number; h?: number }
const { src, alt, caption, bare = false, w = 1600, h = 949 } = Astro.props;
---
<figure class={`ref${bare ? ' ref--bare' : ''}`}>
  <img src={`${src}-1600.webp`} srcset={`${src}-800.webp 800w, ${src}-1600.webp 1600w`} sizes="(max-width: 1080px) 100vw, 1080px"
    alt={alt} loading="lazy" decoding="async" width={w} height={h} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ref { display: grid; gap: var(--s-2); margin: 0; }
  .ref img { width: 100%; height: auto; border-radius: var(--radius-md); border: 1px solid var(--line); background: #fafafa; }
  .ref--bare img { border: 0; border-radius: 0; background: none; filter: drop-shadow(0 28px 36px rgb(16 22 42 / 0.28)); }
  .ref figcaption { font-size: var(--fs-small); color: var(--ink-3); }
</style>
