---
// A real reference image (Figma frame, screenshot) with a caption.
// `src` is the base path: /images/<name> → <name>-800.webp + <name>-1600.webp
interface Props { src: string; alt: string; caption?: string }
const { src, alt, caption } = Astro.props;
---
<figure class="ref">
  <img src={`${src}-1600.webp`} srcset={`${src}-800.webp 800w, ${src}-1600.webp 1600w`} sizes="(max-width: 1080px) 100vw, 1080px"
    alt={alt} loading="lazy" decoding="async" width="1600" height="949" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ref { display: grid; gap: var(--s-2); margin: 0; }
  .ref img { width: 100%; height: auto; border-radius: var(--radius-md); border: 1px solid var(--line); background: #fafafa; }
  .ref figcaption { font-size: var(--fs-small); color: var(--ink-3); }
</style>
