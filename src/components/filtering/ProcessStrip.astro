---
// How the work moved: one line per step, with the artifact each step produced.
import Icon from '../Icon.astro';
const steps = [
  { icon: 'chart', title: 'Spot the stall', text: 'Amplitude: users clicked the same filters again and again without reaching a finding.' },
  { icon: 'grid', title: 'Audit every filter', text: 'Mapped all 6 modules: 4 patterns, 28 flat fields, 3 names for one concept.' },
  { icon: 'compass', title: 'Benchmark', text: 'Linear, Notion, monday.com, Kibana: what each solves well, and what to borrow.' },
  { icon: 'flask', title: 'Prototype two directions', text: 'Logic-first prototypes built with Claude and Dia, compared in A/B sessions with power users.' },
  { icon: 'users', title: 'Test with ~10 users', text: 'Validated the full flow before engineering wrote a line.' },
  { icon: 'rocket', title: 'Ship, then measure', text: 'Rolling out to all clients, with session recordings on defined flows.' },
];
---
<ol class="steps">
  {steps.map((s) => (
    <li>
      <span class="steps__icon"><Icon name={s.icon} size={18} /></span>
      <div><h3>{s.title}</h3><p>{s.text}</p></div>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4) var(--s-3); }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: var(--s-2); align-items: start; }
  .steps__icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 12px; background: var(--tint-2); color: var(--accent); }
  .steps h3 { font-size: 1rem; margin-bottom: 0.25rem; }
  .steps p { font-size: var(--fs-small); }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
