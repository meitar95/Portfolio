---
// How the work moved, in order. Each step names what was actually done.
import Icon from '../Icon.astro';
const steps = [
  { icon: 'search', title: 'Question the assumption', text: '“Most-used” was being read as “works well”. A QA pass on Findings surfaced bugs, so I flagged them to dev.' },
  { icon: 'chart', title: 'Watch the sessions', text: 'Analyzed Amplitude session recordings with Amplitude’s AI agent: repeated clicks, hidden options, exits mid-search.' },
  { icon: 'message', title: 'Ask the customers', text: 'Customer Success reached out to the 3 affected clients. They confirmed it, and blamed themselves.' },
  { icon: 'grid', title: 'Audit every filter', text: 'Mapped all 6 modules: 4 patterns, 28 flat fields, 3 names for one concept.' },
  { icon: 'flask', title: 'Benchmark and prototype', text: 'Borrowed from tools users already know, then compared two logic-first prototypes (Claude, Dia) in A/B sessions.' },
  { icon: 'rocket', title: 'Fast-track, test, ship', text: 'Validated with ~10 users in one cycle, then shipped with session recordings to measure the lift.' },
];
---
<ol class="steps">
  {steps.map((s) => (
    <li>
      <span class="steps__icon"><Icon name={s.icon} size={18} /></span>
      <div><h3>{s.title}</h3><p>{s.text}</p></div>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4) var(--s-3); }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: var(--s-2); align-items: start; }
  .steps__icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 12px; background: var(--tint-2); color: var(--accent); }
  .steps h3 { font-size: 1rem; margin-bottom: 0.25rem; }
  .steps p { font-size: var(--fs-small); }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
