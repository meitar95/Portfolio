---
// "Usage ≠ success": what the dashboard said vs. what session recordings showed.
// The session track is a reconstructed pattern (labelled as such), not real data.
import Icon from '../Icon.astro';
const track = [
  { t: 'Opens Findings', kind: 'neutral' },
  { t: 'Clicks a filter', kind: 'try' },
  { t: 'Again', kind: 'try' },
  { t: 'Again', kind: 'try' },
  { t: 'Option is hidden', kind: 'block' },
  { t: 'Clears all, starts over', kind: 'try' },
  { t: 'Leaves mid-search', kind: 'exit' },
];
---
<figure class="viz">
  <div class="sp">
    <div class="sp__compare">
      <div class="sp__card">
        <span class="sp__icon"><Icon name="chart" size={18} /></span>
        <p class="sp__k">What the dashboard said</p>
        <p class="sp__v">Most-used feature in the product</p>
        <p class="sp__s">Every meeting opened with this number, and everyone read it as success.</p>
      </div>
      <div class="sp__card sp__card--real">
        <span class="sp__icon"><Icon name="alert" size={18} /></span>
        <p class="sp__k">What the recordings showed</p>
        <p class="sp__v">Power users fighting it</p>
        <p class="sp__s">The same filter clicked again and again, no result, then the page left mid-search, several times a day.</p>
      </div>
    </div>

    <div class="sp__track" aria-label="A typical recorded session, reconstructed">
      <p class="sp__label">A typical recorded session <span>(reconstructed pattern)</span></p>
      <ol>
        {track.map((s) => <li class={`step step--${s.kind}`}><i></i><span>{s.t}</span></li>)}
      </ol>
    </div>
  </div>
  <figcaption><b>High usage, unhappy users.</b> The same pattern showed up at 3 different clients.</figcaption>
</figure>

<style>
  .viz { display: grid; gap: var(--s-2); margin: 0; }
  .viz figcaption { font-size: var(--fs-small); color: var(--ink-3); }
  .viz figcaption b { color: var(--ink); font-weight: 500; }
  .sp { display: grid; gap: var(--s-4); background: var(--bg); border-radius: var(--radius-md); padding: var(--s-3); }
  .sp__compare { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); }
  .sp__card { display: grid; gap: 0.375rem; align-content: start; padding: var(--s-3); border-radius: 12px; background: #fff; }
  .sp__card--real { box-shadow: inset 0 0 0 1.5px #e9b6a0; }
  .sp__icon { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 10px; background: var(--tint-2); color: var(--accent); margin-bottom: 0.25rem; }
  .sp__card--real .sp__icon { background: var(--peach); color: #a4502c; }
  .sp__k { font-size: 0.8125rem; color: var(--ink-3); }
  .sp__v { font-size: 1.125rem; font-weight: 500; color: var(--ink); line-height: 1.3; }
  .sp__s { font-size: var(--fs-small); }

  .sp__label { font-size: var(--fs-small); color: var(--ink); font-weight: 500; margin-bottom: var(--s-2); }
  .sp__label span { color: var(--ink-3); font-weight: 400; }
  .sp__track ol { list-style: none; padding: 0; display: flex; position: relative; }
  .sp__track ol::before { content: ''; position: absolute; left: 7px; right: 7px; top: 7px; height: 2px; background: var(--line); }
  .step { position: relative; flex: 1; display: grid; justify-items: start; gap: var(--s-1); padding-right: 0.5rem; }
  .step i { width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 2px #c9c3bf; position: relative; }
  .step span { font-size: 0.8125rem; color: var(--ink-2); line-height: 1.3; }
  .step--try i { box-shadow: inset 0 0 0 2px #e3a87c; background: #fdf1e7; }
  .step--block i { background: #e3a87c; box-shadow: none; }
  .step--exit i { background: #a4502c; box-shadow: none; }
  .step--exit span { color: var(--ink); font-weight: 500; }

  @media (max-width: 720px) {
    .sp__compare { grid-template-columns: 1fr; }
    .sp__track ol { flex-direction: column; gap: var(--s-2); }
    .sp__track ol::before { left: 7px; right: auto; top: 7px; bottom: 7px; width: 2px; height: auto; }
    .step { grid-template-columns: auto 1fr; align-items: center; gap: var(--s-2); }
  }
</style>
