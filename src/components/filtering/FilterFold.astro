---
// Homepage card visual for Filtering: four old filter bars fold into the one new bar.
// Plays once when the card scrolls into view, replays on card hover/focus.
// Decorative (aria-hidden); content mirrors the real before/after in the case study.
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
const old = [
  { name: 'Findings', items: ['Search', '◎ Active only (2)', '+', 'Show filters ▾', 'Clear all'] },
  { name: 'Log analysis', items: ['WAF ▾', 'Domain ▾', 'Action ▾', 'Source IP ▾', 'Time ▾'] },
  { name: 'Achievements', items: ['All', 'Benchmark', 'Posture', 'Milestone'] },
  { name: 'Inventory', items: ['AWS ▾', 'ACL', 'Rules', 'ALB', 'CloudFront'] },
];
---
<div class="ff" data-ff aria-hidden="true">
  <span class="ff__tag ff__tag--old">4 filter bars</span>
  <span class="ff__tag ff__tag--new">1 filter bar, 6 modules</span>
  <div class="ff__old">
    {old.map((b, i) => (
      <div class={`ff__bar ff__bar--${i}`} style={`--i: ${i}; --shift: ${1.5 - i}`}>
        <b>{b.name}</b>
        {b.items.map((t) => <span>{t}</span>)}
      </div>
    ))}
  </div>
  <div class="ff__new">
    <span class="ff__ai">✦ Ask AI…</span>
    <span class="ff__chip" style="--d: 0"><i>Severity</i> is <b>● Critical</b> ×</span>
    <span class="ff__chip" style="--d: 1"><i>Status</i> is <b>Open</b> ×</span>
    <span class="ff__add">+ Add filter</span>
  </div>
  <div class="ff__rows">{Array.from({ length: 5 }).map((_, i) => <i style={`--r: ${i}`}></i>)}</div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ff]').forEach((el) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { el.classList.add('is-new'); return; }
    let t: number | undefined;
    const play = () => {
      clearTimeout(t);
      el.classList.remove('is-new');
      t = window.setTimeout(() => el.classList.add('is-new'), 1300);
    };
    new IntersectionObserver((es, io) => {
      if (es[0].isIntersecting) { play(); io.disconnect(); }
    }, { threshold: 0.6 }).observe(el);
    const card = el.closest('a') ?? el;
    card.addEventListener('mouseenter', play);
    card.addEventListener('focus', play);
  });
</script>

<style>
  .ff {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-md);
    background: #fafafa; font: 400 0.8125rem/1.2 'Plus Jakarta Sans', var(--sans); color: #243165;
    box-shadow: inset 0 0 0 1px rgb(31 21 21 / 0.06);
  }
  .ff__tag {
    position: absolute; top: 0.75rem; left: 0.9rem; font: 500 0.8125rem/1 var(--sans); color: var(--ink-3);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .ff__tag--new { color: var(--accent); opacity: 0; transform: translateY(4px); }
  .ff.is-new .ff__tag--old { opacity: 0; transform: translateY(-4px); }
  .ff.is-new .ff__tag--new { opacity: 1; transform: none; transition-delay: 0.35s; }

  .ff__old { position: absolute; inset: 2.25rem 0.9rem 0.75rem; display: grid; align-content: center; gap: 10px; }
  .ff__bar {
    display: flex; align-items: center; gap: 0.4rem; height: 42px; padding: 0 0.6rem; overflow: hidden; white-space: nowrap;
    background: #fff; border: 1px solid #e3e7ee; border-radius: 10px;
    mask-image: linear-gradient(90deg, #000 88%, transparent); -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent);
    transition: transform 0.6s var(--ease), opacity 0.5s var(--ease);
    transition-delay: calc(var(--i) * 40ms);
  }
  .ff__bar b { font-weight: 600; font-size: 0.6875rem; letter-spacing: 0.04em; text-transform: uppercase; color: #8390a3; min-width: 6.4rem; }
  .ff__bar span { padding: 0.3rem 0.5rem; border: 1px solid #dfe3ea; border-radius: 7px; color: #374151; }
  /* each old pattern looks a little different, like the real ones did */
  .ff__bar--0 span:nth-of-type(2) { background: #e8eefb; border-color: #8ea6e8; color: #2848a8; }
  .ff__bar--2 span { border-radius: 999px; }
  .ff__bar--2 span:first-of-type { background: #e8eefb; border-color: #8ea6e8; }
  .ff__bar--3 span:not(:first-of-type) { border-color: transparent; }
  .ff__bar--3 span:nth-of-type(2) { background: #eef0f4; }
  .ff.is-new .ff__bar { transform: translateY(calc(var(--shift) * 52px)) scale(0.94); opacity: 0; }

  .ff__new {
    position: absolute; left: 0.9rem; right: 0.9rem; top: 2.4rem;
    display: flex; flex-wrap: nowrap; overflow: hidden; white-space: nowrap; align-items: center; gap: 0.45rem; padding: 0.7rem;
    background: #fff; border: 1px solid #e3e7ee; border-radius: 12px; box-shadow: 0 14px 30px -18px rgb(20 30 60 / 0.35);
    opacity: 0; transform: scale(0.96); transition: opacity 0.45s var(--ease), transform 0.5s var(--ease);
  }
  .ff.is-new .ff__new { opacity: 1; transform: none; transition-delay: 0.3s; }
  .ff__ai { padding: 0.3rem 0.7rem; border: 1px solid #4665ff; border-radius: 999px; color: #3665da; }
  .ff__chip {
    display: inline-flex; gap: 0.3rem; align-items: center; padding: 0.3rem 0.5rem; border-radius: 7px; background: #f2f2f2; color: #8390a3;
    opacity: 0; transform: translateY(6px); transition: opacity 0.35s var(--ease), transform 0.4s var(--ease);
  }
  .ff__chip i { font-style: normal; color: #243165; }
  .ff__chip b { font-weight: 600; color: #243165; }
  .ff.is-new .ff__chip { opacity: 1; transform: none; transition-delay: calc(0.6s + var(--d) * 0.12s); }
  .ff__add { color: #287be0; font-weight: 500; }
  /* the results table under the bar, so the after state reads as a real page */
  .ff__rows { position: absolute; left: 0.9rem; right: 0.9rem; top: 6.1rem; bottom: 0.75rem; display: grid; gap: 7px; align-content: start; }
  .ff__rows i {
    height: 22px; border-radius: 6px; background: linear-gradient(90deg, #eceef2 calc(92% - var(--r) * 9%), #f4f5f7 0);
    opacity: 0; transform: translateY(6px); transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .ff.is-new .ff__rows i { opacity: 1; transform: none; transition-delay: calc(0.9s + var(--r) * 0.07s); }

  @media (max-width: 560px) {
    .ff { aspect-ratio: 4 / 3; }
    .ff__bar b { display: none; }
    .ff__bar { height: 36px; }
    .ff__old { gap: 8px; }
    .ff.is-new .ff__bar { transform: translateY(calc(var(--shift) * 44px)) scale(0.94); }
    .ff__new { mask-image: linear-gradient(90deg, #000 85%, transparent); -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ff *, .ff__tag { transition: none !important; }
  }
</style>
