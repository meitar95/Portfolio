---
// Snapshots from Meitar's "filtering-ux" FigJam reference board (11 products, sorted by pattern).
// Featured: the four that shaped the final design. The rest: the wider scan. Tap any image to enlarge.
const featured = [
  { id: 'notion', name: 'Notion', w: 850, h: 446, pattern: 'Collapse into a modal', took: 'Field → operator → value, with is / is not in every condition, and groups when you need them.' },
  { id: 'linear', name: 'Linear', w: 850, h: 339, pattern: 'Collapse into a modal', took: 'The filter reads like a sentence, and saved views stay separate from filter chips.' },
  { id: 'monday', name: 'monday.com', w: 850, h: 478, pattern: 'Collapse into a modal', took: 'AI drafts real filter rows from plain words. This is where my AI placement idea started.' },
  { id: 'kibana', name: 'Kibana', w: 850, h: 465, pattern: 'Filter field, end to end', took: 'Proof that power users need include / exclude and grouped logic.' },
];
const more = [
  { id: 'datadog', name: 'Datadog', w: 850, h: 454, note: 'Removable chips in one search bar, plus facets with live counts' },
  { id: 'jira', name: 'Jira', w: 850, h: 339, note: 'A dropdown per field, with an Advanced switch' },
  { id: 'cycode', name: 'Cycode', w: 900, h: 508, note: 'A dropdown per field, values with counts' },
  { id: 'rapid7', name: 'Rapid7', w: 668, h: 508, note: 'Filter chips that show name and value' },
  { id: 'tenable', name: 'Tenable', w: 375, h: 480, note: 'Side panel, operator per field, then Apply' },
  { id: 'foundry', name: 'Microsoft Foundry', w: 885, h: 508, note: 'Filter panel that slides in from the right' },
  { id: 'sentinelone', name: 'SentinelOne', w: 850, h: 402, note: 'AI builds the query, and you can still edit every part' },
];
const src = (id: string) => `/images/filtering/refs/${id}.webp`;
---
<div class="bm" data-bm>
  <ul class="bm__featured">
    {featured.map((r) => (
      <li>
        <button type="button" class="bm__shot" data-zoom={src(r.id)} data-alt={`${r.name} filtering`} aria-label={`Enlarge ${r.name} screenshot`}>
          <span class="zoom-btn" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></span>
          <img src={src(r.id)} width={r.w} height={r.h} loading="lazy" decoding="async" alt={`${r.name} filtering`} />
        </button>
        <p class="bm__pattern">{r.pattern}</p>
        <b>{r.name}</b>
        <p>{r.took}</p>
      </li>
    ))}
  </ul>

  <p class="bm__more-label">Also on my reference board</p>
  <ul class="bm__more">
    {more.map((r) => (
      <li>
        <button type="button" class="bm__shot" data-zoom={src(r.id)} data-alt={`${r.name} filtering`} aria-label={`Enlarge ${r.name} screenshot`}>
          <span class="zoom-btn" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></span>
          <img src={src(r.id)} width={r.w} height={r.h} loading="lazy" decoding="async" alt={`${r.name} filtering`} />
        </button>
        <b>{r.name}</b>
        <span>{r.note}</span>
      </li>
    ))}
  </ul>
  <p class="bm__cap">11 products from my FigJam research board, sorted by filtering pattern. Tap any snapshot to enlarge.</p>

</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-bm]').forEach((root) => {
    // Same full-screen viewer as every other screen on the site
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => {
      dispatchEvent(new CustomEvent('zoom', { detail: { items: [{ src: b.dataset.zoom!, label: b.dataset.alt! }] } }));
    }));
  });
</script>

<style>
  .bm { display: grid; gap: var(--s-3); }
  .bm__featured { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--s-3); }
  .bm__featured li { display: grid; gap: 6px; align-content: start; }
  .bm__featured b { color: var(--ink); font-weight: 500; }
  .bm__featured p { font-size: var(--fs-small); }
  .bm__pattern { color: var(--accent); font-weight: 500; margin-top: var(--s-1); }
  .bm__shot {
    position: relative; display: grid; place-items: center; padding: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
    background: #f4f5f7; cursor: zoom-in; aspect-ratio: 16 / 9; transition: box-shadow 0.25s, transform 0.25s var(--ease);
  }
  .bm__shot:hover { box-shadow: 0 12px 28px -14px rgb(16 22 42 / 0.35); transform: translateY(-2px); }
  .bm__more .zoom-btn { width: 30px; height: 30px; top: 6px; right: 6px; }
  .bm__shot:focus-visible { outline: 3px solid var(--tint-5); outline-offset: 2px; }
  .bm__shot img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .bm__more-label { font-size: var(--fs-small); font-weight: 500; color: var(--ink); margin-top: var(--s-2); }
  .bm__more {
    list-style: none; padding: 0 0 6px; margin: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(200px, 23%);
    gap: var(--s-2); overflow-x: auto; scroll-snap-type: x mandatory;
  }
  .bm__more li { display: grid; gap: 4px; align-content: start; scroll-snap-align: start; }
  .bm__more b { color: var(--ink); font-weight: 500; font-size: 0.9375rem; margin-top: 4px; }
  .bm__more span { font-size: 0.875rem; color: var(--ink-3); line-height: 1.4; }
  .bm__cap { font-size: var(--fs-small); color: var(--ink-3); }
  @media (max-width: 640px) {
    .bm__featured { grid-template-columns: 1fr; }
    .bm__more { grid-auto-columns: 70%; }
  }
</style>
