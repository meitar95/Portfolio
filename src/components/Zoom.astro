---
// One shared full-screen viewer for product screens. Wide desktop screenshots are hard
// to read on a phone, so any component can open them here at full resolution, where
// they can be panned sideways and pinch-zoomed.
//   window.dispatchEvent(new CustomEvent('zoom', { detail: [{ src, label? }, ...] }))
---
<dialog class="zm" data-zoomer aria-label="Enlarged screen">
  <div class="zm__bar">
    <span class="zm__hint">Swipe or pinch to look around</span>
    <form method="dialog"><button class="zm__close" aria-label="Close">×</button></form>
  </div>
  <div class="zm__body" data-zoom-body></div>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-zoomer]');
  const body = document.querySelector<HTMLElement>('[data-zoom-body]');
  if (dlg && body) {
    addEventListener('zoom', (e) => {
      const items = (e as CustomEvent<{ src: string; label?: string }[]>).detail;
      body.innerHTML = '';
      for (const it of items) {
        const fig = document.createElement('figure');
        if (it.label) { const l = document.createElement('figcaption'); l.textContent = it.label; fig.append(l); }
        const sc = document.createElement('div'); sc.className = 'zm__scroll';
        const img = document.createElement('img'); img.src = it.src; img.alt = it.label ?? 'Enlarged screen';
        sc.append(img); fig.append(sc); body.append(fig);
      }
      dlg.showModal();
      // Start each wide image centered-left, like reading a page
      body.querySelectorAll('.zm__scroll').forEach((s) => (s.scrollLeft = 0));
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>

<style is:global>
  .zm { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0; background: #10162a; color: #fff; }
  .zm::backdrop { background: rgb(16 22 42 / 0.85); }
  .zm[open] { display: grid; grid-template-rows: auto 1fr; }
  .zm__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.5rem 0.5rem 1rem; }
  .zm__hint { font-size: var(--fs-small); color: #b8c2d9; }
  .zm__close { width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.12); color: #fff; font-size: 1.75rem; line-height: 1; cursor: pointer; }
  .zm__body { overflow-y: auto; display: grid; gap: 1.25rem; align-content: start; padding: 0 0 2rem; }
  .zm__body figure { margin: 0; display: grid; gap: 0.5rem; }
  .zm__body figcaption { padding: 0 1rem; font-size: var(--fs-small); font-weight: 500; color: #dfe5f2; }
  .zm__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  /* Wide screens open at a readable width (pan sideways); never smaller than the viewport */
  .zm__scroll img { display: block; width: max(100%, 1000px); max-width: none; height: auto; }
  @media (min-width: 1000px) { .zm__scroll img { width: min(100%, 1600px); margin-inline: auto; } }
  /* Expand buttons placed on screens by FlowScreens and the before/after sliders */
  .zoom-btn {
    position: absolute; top: 10px; right: 10px; z-index: 12; display: inline-flex; align-items: center; gap: 0.35rem;
    min-height: 36px; padding: 0 0.75rem; border: 0; border-radius: 999px; cursor: pointer;
    background: rgb(16 22 42 / 0.72); color: #fff; font: 500 0.875rem/1 var(--sans);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .zoom-btn:hover { background: rgb(16 22 42 / 0.9); }
  .zoom-btn:focus-visible { outline: 3px solid var(--tint-5); outline-offset: 2px; }
</style>
