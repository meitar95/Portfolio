---
// Sentrycs hero: three real before/after pairs from the design file (shared slider).
import BeforeAfterSlider from '../BeforeAfterSlider.astro';
const pairs = [
  { id: 'realtime', label: 'Real time', note: 'Live map: the screen operators watch all shift.' },
  { id: 'analytics', label: 'Analytics', note: 'Same charts, readable at a glance, one visual language.' },
  { id: 'settings', label: 'Settings', note: 'Tables and tabs that match the rest of the system.' },
];
---
<BeforeAfterSlider pairs={pairs} dir="/images/sentrycs" w={1600} h={787}
  altAfter="After: the redesigned Sentrycs screen"
  caption="Drag to compare the legacy UI (left) with the redesign (right). Demo data." />
