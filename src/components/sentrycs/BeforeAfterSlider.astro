---
// Drag-to-compare: the shipped redesign over the legacy UI, same screen, same data.
// Tabs switch between three real before/after pairs from the Sentrycs design file.
const pairs = [
  { id: 'realtime', label: 'Real time', note: 'Live map: the screen operators watch all shift.' },
  { id: 'analytics', label: 'Analytics', note: 'Same charts, readable at a glance, one visual language.' },
  { id: 'settings', label: 'Settings', note: 'Tables and tabs that match the rest of the system.' },
];
const img = (id: string, v: 'before' | 'after') => `/images/sentrycs/${id}-${v}`;
---
<figure class="bas" data-bas>
  <div class="bas__top">
    <div class="bas__tabs" role="tablist" aria-label="Choose a screen">
      {pairs.map((p, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pair={p.id} data-note={p.note}>{p.label}</button>)}
    </div>
    <p class="bas__note" data-note-out aria-live="polite">{pairs[0].note}</p>
  </div>

  <div class="bas__stage" data-stage style="--pos: 50%">
    <img class="bas__img" data-after src={`${img('realtime', 'after')}-1600.webp`} srcset={`${img('realtime', 'after')}-800.webp 800w, ${img('realtime', 'after')}-1600.webp 1600w`} sizes="(max-width: 1080px) 100vw, 1080px" width="1600" height="787" alt="After: the redesigned Sentrycs screen" />
    <div class="bas__clip" aria-hidden="true">
      <img class="bas__img" data-before src={`${img('realtime', 'before')}-1600.webp`} srcset={`${img('realtime', 'before')}-800.webp 800w, ${img('realtime', 'before')}-1600.webp 1600w`} sizes="(max-width: 1080px) 100vw, 1080px" width="1600" height="787" alt="" />
    </div>
    <span class="bas__tag bas__tag--before">Before</span>
    <span class="bas__tag bas__tag--after">After</span>
    <div class="bas__handle" aria-hidden="true"><span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18-6-6 6-6M15 6l6 6-6 6"/></svg>
    </span></div>
    <label class="visually-hidden" for="bas-range">Compare before and after</label>
    <input id="bas-range" class="bas__range" type="range" min="0" max="100" value="50" data-range />
  </div>
  <figcaption class="bas__caption">Drag to compare the legacy UI (left) with the redesign (right). Demo data.</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-bas]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const range = root.querySelector<HTMLInputElement>('[data-range]')!;
    const before = root.querySelector<HTMLImageElement>('[data-before]')!;
    const after = root.querySelector<HTMLImageElement>('[data-after]')!;
    const note = root.querySelector<HTMLElement>('[data-note-out]')!;
    const set = (v: number) => stage.style.setProperty('--pos', `${v}%`);
    range.addEventListener('input', () => set(+range.value));
    // Click anywhere on the image to jump the handle there
    stage.addEventListener('pointerdown', (e) => {
      if (e.target === range) return;
      const r = stage.getBoundingClientRect();
      const v = Math.round(((e.clientX - r.left) / r.width) * 100); range.value = String(v); set(v);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-pair]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-pair]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      const id = b.dataset.pair!;
      for (const [el, v] of [[before, 'before'], [after, 'after']] as const) {
        el.src = `/images/sentrycs/${id}-${v}-1600.webp`;
        el.srcset = `/images/sentrycs/${id}-${v}-800.webp 800w, /images/sentrycs/${id}-${v}-1600.webp 1600w`;
      }
      note.classList.add('is-out');
      setTimeout(() => { note.textContent = b.dataset.note!; note.classList.remove('is-out'); }, 220);
      range.value = '50'; set(50);
    }));
  });
</script>

<style>
  .bas { display: grid; gap: var(--s-3); margin: 0; }
  .bas__top { display: grid; gap: var(--s-2); justify-items: start; }
  .bas__tabs { display: inline-flex; gap: 4px; padding: 4px; background: var(--tint-1); border-radius: var(--radius-pill); flex-wrap: wrap; }
  .bas__tabs button {
    border: 0; background: none; cursor: pointer; min-height: 40px; padding: 0 1.1rem; border-radius: var(--radius-pill);
    font-size: var(--fs-small); font-weight: 500; color: var(--ink-3); transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .bas__tabs button[aria-selected='true'] { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgb(31 21 21 / 0.08), 0 2px 8px -2px rgb(31 21 21 / 0.12); }
  .bas__note { color: var(--ink); transition: opacity 0.45s var(--ease), transform 0.45s var(--ease), filter 0.45s var(--ease); }
  .bas__note.is-out { opacity: 0; transform: translateY(4px); filter: blur(3px); transition-duration: 0.2s; }

  .bas__stage {
    position: relative; overflow: hidden; border-radius: var(--radius-md); background: #10162a;
    aspect-ratio: 1920 / 944; touch-action: pan-y; user-select: none;
    box-shadow: 0 16px 40px -16px rgb(16 22 42 / 0.45);
  }
  .bas__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .bas__clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .bas__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.15); pointer-events: none; }
  .bas__handle span {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: #fff; color: var(--ink); box-shadow: 0 4px 16px rgb(0 0 0 / 0.3);
  }
  .bas__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .bas__range:focus-visible ~ .bas__handle span, .bas__stage:has(.bas__range:focus-visible) .bas__handle span { outline: 3px solid var(--tint-5); outline-offset: 2px; }
  .bas__tag {
    position: absolute; bottom: 12px; padding: 0.25rem 0.625rem; border-radius: 6px;
    background: rgb(0 0 0 / 0.55); color: #fff; font-size: 0.8125rem; font-weight: 500; pointer-events: none;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .bas__tag--before { left: 12px; }
  .bas__tag--after { right: 12px; }
  .bas__caption { font-size: var(--fs-small); color: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) { .bas__note { transition: none; } }
</style>
