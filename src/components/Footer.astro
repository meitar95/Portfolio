---
import Button from './Button.astro';
// Closing band. Instagram left out until confirmed as design work.
// Two small sparkles next to the heading echo the hero avatar, recolored for the dark band.
---
<footer class="footer" id="contact">
  <div class="container footer__inner">
    <h2>Thanks for stopping by.<span class="footer__sparks" aria-hidden="true"><svg class="fs fs--big" viewBox="0 0 12 12"><path d="M6 1v3M6 8v3M1 6h3M8 6h3" /></svg><svg class="fs fs--small" viewBox="0 0 12 12"><path d="M6 1v3M6 8v3M1 6h3M8 6h3" /></svg></span></h2>
    <p>Looking for a product designer who can own complex systems end to end? I'd love to talk.</p>
    <Button href="https://cal.com/meitar/30min" variant="light">Book a 30-min call</Button>
    <ul class="footer__links">
      <li><a href="https://www.linkedin.com/in/meitar-m">LinkedIn</a></li>
      <li><a href="mailto:meitarxd@gmail.com">meitarxd@gmail.com</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    /* Softer than the old pure-black gradient: warm ink into deep slate */
    background: linear-gradient(180deg, #2b2a3d 0%, #1f1b22 100%);
    color: rgb(255 255 255 / 0.78);
    padding-block: var(--s-7);
  }
  .footer__inner { display: grid; gap: var(--s-3); justify-items: start; }
  .footer h2 { color: #fff; }
  .footer__sparks { position: relative; display: inline-block; width: 0.75em; height: 0.6em; margin-left: 0.15em; vertical-align: 0.3em; }
  .fs { position: absolute; fill: none; stroke-linecap: round; stroke-width: 1.3; animation: fs-twinkle 5.5s ease-in-out infinite; }
  .fs--big { width: 0.42em; left: 0; top: 0.16em; stroke: #9fb8ff; }
  .fs--small { width: 0.24em; left: 0.44em; top: -0.02em; stroke: #8fe3d0; animation-delay: -2.4s; }
  @keyframes fs-twinkle {
    0%, 100% { opacity: 0.35; transform: scale(0.85) rotate(0deg); }
    50% { opacity: 0.9; transform: scale(1) rotate(20deg); }
  }
  @media (prefers-reduced-motion: reduce) { .fs { animation: none; opacity: 0.7; } }
  .footer__links { display: flex; flex-wrap: wrap; gap: var(--s-3); list-style: none; padding: 0; margin-top: var(--s-2); }
  .footer__links a { color: #fff; text-underline-offset: 4px; padding-block: 0.6rem; display: inline-block; }
</style>
