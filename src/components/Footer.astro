<style>
  .footer {
    /* Softer than the old pure-black gradient: warm ink into deep slate */
    background: linear-gradient(180deg, #2b2a3d 0%, #1f1b22 100%);
    color: rgb(255 255 255 / 0.78);
    padding-block: var(--s-7);
  }
  .footer__inner { display: grid; gap: var(--s-3); justify-items: start; }
  .footer h2 { color: #fff; }
  .footer__links { display: flex; flex-wrap: wrap; gap: var(--s-3); list-style: none; padding: 0; margin-top: var(--s-2); }
  .footer__links a { color: #fff; text-underline-offset: 4px; padding-block: 0.6rem; display: inline-block; }
</style>
