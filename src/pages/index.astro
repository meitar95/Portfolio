---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroGlow from '../components/HeroGlow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MotionReel from '../components/MotionReel.astro';
import Button from '../components/Button.astro';
import FilterAICard from '../components/filtering/FilterAICard.astro';
import HeroAvatar from '../components/HeroAvatar.astro';

// Drafts show in local preview only; production gets finished work only.
const showDrafts = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_DRAFTS === 'true';
const work = (await getCollection('work', ({ data }) => showDrafts || !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// "What I bring": four groups, each with one line of proof from real work and its skills as quiet tags.
// Same column pattern as the case-study solution points (tint-4 top rule, small heading, short text).
const skills = [
  { t: 'Product & UX', d: 'From the first question to a shipped flow, tested with real users.', tags: ['Product design', 'UX design', 'Interaction design', 'Usability testing', 'Design sprints'] },
  { t: 'Design systems', d: 'Built from scratch across 5+ design languages, checked through release.', tags: ['Design systems', 'Design QA'] },
  { t: 'AI-native', d: 'Working prototypes in Claude and Cursor, small UI fixes shipped to code.', tags: ['AI-native workflows', 'Prototyping'] },
  { t: 'Motion', d: 'Micro-interactions and product illustration, trained in animation at Shenkar.', tags: ['Motion & micro-interactions', 'Lottie'] },
];

const experience = [
  {
    role: 'Product Designer', org: 'Huskeys', when: '2025 – Present',
    about: 'B2B cybersecurity startup, WAF & API protection',
    points: [
      'First product designer. Built the design function and helped grow the team to five.',
      'Shipped onboarding end to end, raising capacity ~10x (1 → 10+ clients a week).',
      'Unified four filtering patterns across six modules into one system.',
      'Work AI-native with Claude, Figma and Cursor, and lead a unified design system as the product scales.',
    ],
  },
  {
    role: 'Product Designer & Design Project Manager', org: 'UI Human Factors', when: '2022 – 2025',
    about: 'Product design consultancy, complex B2B & B2C systems',
    points: [
      'Designed end to end for enterprise clients in cybersecurity, medical, fintech and agri-tech, including Medtronic, Bank Leumi, Cybersixgill, Sentrycs and Afimilk.',
      "Redesigned Afimilk's field app for dairy farmers, from near-zero usage to daily use on ~15,000 farms in 50+ countries.",
      'Scaled the Sentrycs counter-drone redesign from one concept into an 8-module design system, then shipped it as sole designer at ~90% fidelity.',
      'Built design systems from scratch for web and mobile, ran usability testing and owned Design QA.',
    ],
  },
];
---
<Base
  title="Meitar Mechoresh · Product Designer"
  description="Product designer for cybersecurity and complex B2B. Founding designer at Huskeys, almost 5 years turning complex systems into tools people trust. AI-native."
>
  <section class="hero">
    <HeroGlow />
    <div class="container hero__inner">
      <div class="hero__hello">
        <HeroAvatar />
        <h1>Hi, I'm Meitar Mechoresh.</h1>
      </div>
      <p class="hero__role">Product Designer · Cybersecurity & complex B2B · AI-native</p>
      <p class="hero__lead">
        Founding designer at Huskeys, where I'm building WAF and API security from zero.
        Almost 5 years of making complicated systems feel clear, and I use AI every day to test ideas fast.
      </p>
      <Button href="https://cal.com/meitar/30min">Contact me</Button>
    </div>
  </section>

  <section class="section work" id="work" aria-labelledby="work-title">
    <div class="container">
      <h2 id="work-title" class="visually-hidden">Selected work</h2>
      <div class="work__list">
        {work.map((w, i) => (
          <ProjectCard
            title={w.data.title}
            text={w.data.card}
            meta={w.data.platform}
            href={w.data.draft ? undefined : `/work/${w.id}/`}
            tint={Math.min(i + 1, 5)}
            cover={w.data.cover}
            coverAlt={w.data.coverAlt}
            draft={w.data.draft}
          >
            {w.id === 'filtering' && <FilterAICard slot="visual" />}
          </ProjectCard>
        ))}
      </div>
    </div>
  </section>

  <section class="section skills" aria-labelledby="skills-title">
    <div class="container">
      <h2 id="skills-title" class="section__title">What I bring</h2>
      <ul class="bring reveal">
        {skills.map((g) => (
          <li>
            <h3>{g.t}</h3>
            <p>{g.d}</p>
            <ul class="bring__tags" aria-label={`${g.t} skills`}>{g.tags.map((x) => <li>{x}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <MotionReel />

  <section class="section" id="experience" aria-labelledby="exp-title">
    <div class="container">
      <h2 id="exp-title" class="section__title">Experience</h2>
      {experience.map((e) => (
        <article class="exp reveal">
          <header class="exp__head">
            <h3>{e.role}&nbsp;· {e.org}</h3>
            <p class="exp__when">{e.when}</p>
          </header>
          <p class="eyebrow">{e.about}</p>
          <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
        </article>
      ))}

      <article class="exp reveal">
        <header class="exp__head">
          <h3>B.Design, Visual Communication&nbsp;· Shenkar College</h3>
          <p class="exp__when">2019 – 2023</p>
        </header>
        <p class="eyebrow">Digital products & animation</p>
      </article>
      <article class="exp reveal">
        <header class="exp__head">
          <h3>Design Thinking Hackathon&nbsp;· Tel Aviv University × Hong Kong University</h3>
          <p class="exp__when">2023</p>
        </header>
        <p>Joined MBA courses and an Executive MBA hackathon as both a team and solo designer, working with Israeli startups preparing to enter Asian markets.</p>
      </article>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; isolation: isolate; overflow-x: clip; /* glow may spill down, never sideways */ padding-block: clamp(4rem, 10vw, 8rem) var(--s-6); }
  .hero__inner { display: grid; gap: var(--s-3); justify-items: start; }
  .hero__role { font-size: var(--fs-lead); color: var(--ink); }
  .hero__lead { font-size: var(--fs-lead); line-height: 1.55; max-width: 60ch; }
  .hero__hello { display: flex; align-items: center; gap: clamp(1.5rem, 3vw, 2.25rem); }
  @media (max-width: 809px) { .hero__hello { flex-direction: column; align-items: flex-start; gap: var(--s-3); } }

  .section__title { margin-bottom: var(--s-5); }
  .work { padding-top: var(--s-5); padding-bottom: var(--s-5); }
  .skills { padding-block: var(--s-4); }
  .work__list { display: grid; gap: var(--s-3); }

  .skills .container { background: var(--surface-muted); border-radius: var(--radius-lg); padding: clamp(1.5rem, 1rem + 2.5vw, 3rem); }
  .skills .section__title { margin-bottom: var(--s-3); }
  .bring { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4) var(--s-3); }
  .bring > li { display: grid; gap: var(--s-1); align-content: start; padding-top: var(--s-2); border-top: 2px solid var(--tint-4); }
  .bring h3 { font-size: var(--fs-body); }
  .bring p { font-size: var(--fs-small); color: var(--ink-2); }
  /* Tags read as labels, not buttons: no fill, thin outline, small */
  .bring__tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--s-1); }
  .bring__tags li { padding: 0.25rem 0.6rem; border: 1px solid var(--line); border-radius: var(--radius-pill); font-size: 0.875rem; color: var(--ink-2); background: rgb(255 255 255 / 0.6); }
  @media (max-width: 1023px) { .bring { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .bring { grid-template-columns: 1fr; } }

  .exp { display: grid; gap: var(--s-1); padding-block: var(--s-4); border-top: 1px solid var(--line); }
  .exp__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-1) var(--s-3); align-items: baseline; }
  .exp__when { color: var(--ink-3); font-size: var(--fs-small); white-space: nowrap; }
  .exp ul { padding-left: 1.1rem; display: grid; gap: var(--s-1); margin-top: var(--s-1); max-width: 72ch; }
</style>
