---
// THE case-study template. Every study renders through this file, in this order:
//   Above the fold: title + payoff · role/team/timeline · outcomes · why · solution
//   Below the fold: the problem · the evidence · the result (MDX body) · what we learned · next study
//
// Spacing system (one rule, used everywhere on the page):
//   --gap-section  between sections           (96px desktop → 64px phone)
//   --gap-pair     heading → its paragraph    (12px: they read as one unit)
//   --gap-content  paragraph → visual/list    (32px)
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FilterBeforeAfter from '../../components/filtering/FilterBeforeAfter.astro';
import SentrycsSlider from '../../components/sentrycs/BeforeAfterSlider.astro';
import FarmersBeforeAfter from '../../components/farmers/FarmersBeforeAfter.astro';
import C6gScreens from '../../components/cybersixgill/C6gScreens.astro';
import HerdSlider from '../../components/herd/HerdSlider.astro';

export async function getStaticPaths() {
  const all = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const visuals = { 'filtering-before-after': FilterBeforeAfter, 'sentrycs-before-after': SentrycsSlider,
  'farmers-before-after': FarmersBeforeAfter,
  'cybersixgill-screens': C6gScreens,
  'herd-before-after': HerdSlider };
const Visual = d.visual ? visuals[d.visual] : null;
---
<Base title={`${d.title} · Meitar Mechoresh`} description={d.tagline}>
  <article class="cs">
    <div class="container cs__flow">
      <header class="cs__hero">
        <div class="pair">
          <h1>{d.title}</h1>
          <p class="cs__tagline">{d.tagline}</p>
        </div>
        <dl class="cs__meta">
          <div><dt>Role</dt><dd>{d.role}</dd></div>
          <div><dt>Team</dt><dd>{d.team}</dd></div>
          <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>
          <div><dt>Platform</dt><dd>{d.platform}</dd></div>
        </dl>
        <ul class="cs__outcomes" aria-label="Outcomes">
          {d.outcomes.map((o) => <li><strong>{o.value}</strong><span>{o.label}</span></li>)}
        </ul>
      </header>

      <section class="pair reveal" aria-labelledby="why">
        <h2 id="why">Why it mattered</h2>
        <p class="lead">{d.why}</p>
      </section>

      <section class="cs__solution" aria-labelledby="solution">
        <div class="pair reveal">
          <h2 id="solution">The solution</h2>
          <p class="lead">{d.solution.summary}</p>
        </div>
        {Visual && <Visual />}
        <ul class="cs__points reveal">
          {d.solution.points.map((p) => <li><h3>{p.title}</h3><p>{p.text}</p></li>)}
        </ul>
      </section>

    </div>

    <div class="cs__fold">
      <div class="container cs__body">
        <Content />
        <section class="pair reveal cs__learned" aria-labelledby="learned">
          <h2 id="learned">What we learned</h2>
          <blockquote class="cs__quote"><p>{d.learned}</p></blockquote>
        </section>
        {d.confidential && <p class="cs__note">All visuals use generic, non-company data for confidentiality.</p>}
      </div>
    </div>

    {next && next.id !== entry.id && (
      <nav class="container cs__next" aria-label="Next case study">
        <p class="eyebrow">Next case study</p>
        <a href={`/work/${next.id}/`}>{next.data.title.split(' ').slice(0, -1).join(' ')} <span class="nowrap">{next.data.title.split(' ').at(-1)}&nbsp;<span aria-hidden="true">→</span></span></a>
      </nav>
    )}
  </article>
</Base>

<style>
  .cs {
    --gap-section: clamp(4rem, 2.5rem + 4vw, 6rem);
    --gap-pair: 0.75rem;
    --gap-content: 2rem;
  }
  .cs__flow { display: grid; gap: var(--gap-section); padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) var(--gap-section); }

  /* A heading and its paragraph read as one unit */
  .pair { display: grid; gap: var(--gap-pair); align-content: start; }
  .lead { font-size: var(--fs-lead); line-height: 1.55; }

  .cs__hero { display: grid; gap: var(--gap-content); }
  .cs__tagline { font-size: var(--fs-lead); color: var(--ink); max-width: 52ch; }

  .cs__meta {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-3);
    padding-block: var(--s-3); border-block: 1px solid var(--line);
  }
  .cs__meta dt { font-size: var(--fs-small); color: var(--ink-3); }
  .cs__meta dd { margin: 0.25rem 0 0; color: var(--ink); font-weight: 500; }

  .cs__outcomes { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-2); margin-top: calc(var(--s-2) - var(--gap-content)); }
  .cs__outcomes li { background: var(--tint-2); border-radius: var(--radius-md); padding: var(--s-3); display: grid; gap: 0.375rem; align-content: start; }
  .cs__outcomes strong {
    font-family: var(--sans); font-weight: 500; letter-spacing: -0.02em;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem); color: var(--ink); line-height: 1.1;
  }
  .cs__outcomes span { color: var(--ink-2); font-size: var(--fs-small); line-height: 1.45; }

  .cs__solution { display: grid; gap: var(--gap-content); }
  .cs__points { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: var(--s-4) var(--s-3); }
  .cs__points li { display: grid; gap: var(--s-1); align-content: start; padding-top: var(--s-2); border-top: 2px solid var(--tint-4); }
  .cs__points h3 { font-size: var(--fs-body); }
  .cs__points p { font-size: var(--fs-small); }

  .cs__learned { margin-top: calc(var(--gap-section) - var(--gap-content)); }
  .cs__quote { border-left: 3px solid var(--accent); padding-left: var(--s-3); }
  .cs__quote p { font-family: var(--serif); font-size: var(--fs-h3); color: var(--ink); line-height: 1.45; max-width: 46ch; }

  /* Below the fold: same rhythm, white surface */
  .cs__fold { background: var(--surface); padding-block: var(--gap-section); }
  .cs__body { display: grid; gap: var(--gap-content); }
  /* Direct children only (>), so headings inside visuals keep their own spacing */
  .cs__body > :global(h2) { margin-top: calc(var(--gap-section) - var(--gap-content)); }
  .cs__body > :global(h2:first-child) { margin-top: 0; }
  .cs__body > :global(h2 + p), .cs__body > :global(h3 + p) { margin-top: calc(var(--gap-pair) - var(--gap-content)); }
  .cs__body > :global(h3) { margin-top: calc(var(--s-5) - var(--gap-content)); }
  .cs__body :global(strong) { color: var(--ink); font-weight: 500; }
  .cs__note { font-size: var(--fs-small); color: var(--ink-3); }

  .cs__next { padding-block: var(--gap-section); display: grid; gap: var(--s-1); }
  .cs__next a { font-family: var(--serif); font-size: var(--fs-h2); color: var(--ink); text-decoration: none; }
  .cs__next a:hover { color: var(--accent); }

  @media (max-width: 809px) {
    .cs__meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs__outcomes { grid-template-columns: 1fr; gap: var(--s-1); }
    .cs__outcomes li { grid-template-columns: minmax(5.5rem, auto) 1fr; align-items: center; gap: var(--s-2); padding: var(--s-2); }
    .cs__outcomes strong { font-size: 1.5rem; white-space: nowrap; }
    .cs__quote p { font-size: var(--fs-lead); }
  }
  /* Phones: one fact per row (label left, value right) so long roles and teams don't
     turn into tall, ragged half-width columns */
  @media (max-width: 600px) {
    .cs__meta { grid-template-columns: 1fr; gap: var(--s-2); }
    .cs__meta > div { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--s-2); align-items: baseline; }
    .cs__meta dd { margin: 0; }
  }
  .nowrap { white-space: nowrap; }
</style>
